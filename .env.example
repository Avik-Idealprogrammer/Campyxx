APP_ENV=development
POSTGRES_DB=campusflow
POSTGRES_USER=campusflow
POSTGRES_PASSWORD=generated-by-create-dev-env
JWT_SECRET=generated-by-create-dev-env
COOKIE_SECURE=false

# Optional overrides for local dev outside Docker (e.g., uvicorn backend.main:app --reload)
# DATABASE_URL=postgresql://campusflow:password@localhost:5432/campusflow
# REDIS_URL=redis://localhost:6379/0

# Seed accounts for initial verification and demo testing
DEMO_SEED_USERS=true
DEMO_ADMIN_EMAIL=admin.demo@example.invalid
DEMO_ADMIN_PASSWORD=generated-by-create-dev-env
DEMO_FACULTY_EMAIL=faculty.demo@example.invalid
DEMO_FACULTY_PASSWORD=generated-by-create-dev-env
DEMO_STUDENT_EMAIL=student.demo@example.invalid
DEMO_STUDENT_PASSWORD=generated-by-create-dev-env
